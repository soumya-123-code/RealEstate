NODE_ENV=production
PORT=8800

# MySQL / MariaDB
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE"

# Public frontend origin. If frontend and API are same-origin, use your site URL.
CLIENT_URL="https://suretreaven.com"

# Generate a long random secret (do not reuse development secrets).
JWT_SECRET_KEY="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# WhatsApp Business destination number in international format, digits only.
WHATSAPP_BUSINESS_NUMBER="91XXXXXXXXXX"

# SMTP is required for production email OTP delivery.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM_EMAIL="no-reply@suretreaven.com"

# A real SMS provider is required for production phone OTP.
SMS_PROVIDER=""

COMPANY_NAME="Suretreaven"
