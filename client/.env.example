# ─────────────────────────────────────────────────────────────
# Suretreaven client — API endpoints
# Vite loads: .env → .env.local → .env.[mode] → .env.[mode].local
# ─────────────────────────────────────────────────────────────

# ── Development (npm run dev) ───────────────────────────────
# Relative /api uses the Vite proxy → local API (see vite.config.js).
# Copy these into .env.development or .env.local:
#
# VITE_API_URL=/api
# VITE_SOCKET_URL=http://localhost:8800
#
# Or point the browser straight at production while developing UI:
# VITE_API_URL=https://api.suretreaven.com/api
# VITE_SOCKET_URL=https://api.suretreaven.com

# ── Production (npm run build) ──────────────────────────────
# Defaults are already set in .env.production; override if needed:
VITE_API_URL=https://api.suretreaven.com/api
VITE_SOCKET_URL=https://api.suretreaven.com

# Health check: https://api.suretreaven.com/api/health
