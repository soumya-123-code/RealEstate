# ─────────────────────────────────────────────────────────────
# Suretreaven API — environment
# Copy to .env and fill in secrets. Never commit real credentials.
# ─────────────────────────────────────────────────────────────

# development | production
NODE_ENV=development
PORT=8800

# MySQL / MariaDB
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE"

# ── Development ─────────────────────────────────────────────
# CLIENT_URL="http://localhost:5173"
# JWT_SECRET_KEY="dev-only-change-me"
# Cookie: sameSite=lax, secure=false when NODE_ENV !== production

# ── Production ──────────────────────────────────────────────
# CLIENT_URL="https://suretreaven.com"
# JWT_SECRET_KEY="REPLACE_WITH_A_LONG_RANDOM_SECRET"
# Cookie: sameSite=none, secure=true when NODE_ENV=production
# CORS allows CLIENT_URL (+ CHAT_APP_URL if set)

CLIENT_URL="http://localhost:5173"
# Optional second origin (e.g. staff chat app)
# CHAT_APP_URL="http://localhost:3001"

JWT_SECRET_KEY="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# WhatsApp Business destination number (digits only, international)
WHATSAPP_BUSINESS_NUMBER="91XXXXXXXXXX"

# SMTP — required for production email OTP
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM_EMAIL="no-reply@suretreaven.com"

# SMS provider stub — production should use a real provider
SMS_PROVIDER=""

COMPANY_NAME="Suretreaven"
